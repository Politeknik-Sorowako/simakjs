{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "start:dev": "bun --watch src/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bun run src/scripts/ensure-enums.ts && bunx drizzle-kit push",
    "db:seed-test": "bun run src/scripts/seed-test-data.ts",
    "db:reset": "bun run src/scripts/reset-db.ts",
    "db:backup": "bun run src/scripts/backup-db.ts",
    "db:restore": "bun run src/scripts/restore-db.ts",
    "db:safe-migrate": "bun run src/scripts/safe-migrate.ts",
    "db:reset-baseline": "bun run src/scripts/reset-baseline.ts",
    "test": "DATABASE_URL=${DATABASE_URL_TEST:-postgresql://simak_user:simak_password@localhost:5433/simak_vokasi_test} bun run src/scripts/pre-test.ts && DATABASE_URL=${DATABASE_URL_TEST:-postgresql://simak_user:simak_password@localhost:5433/simak_vokasi_test} bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.0.0",
    "@elysiajs/jwt": "^1.0.0",
    "@elysiajs/swagger": "^1.0.0",
    "drizzle-orm": "^0.45.0",
    "elysia": "^1.0.0",
    "pg": "^8.11.0",
    "resend": "^6.16.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "@types/pg": "^8.11.0",
    "@types/bun": "latest",
    "@types/node": "^20.0.0"
  }
}
