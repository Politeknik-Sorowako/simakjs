# Konfigurasi Database PostgreSQL
POSTGRES_USER=simak_user
POSTGRES_PASSWORD=simak_password
POSTGRES_DB=simak_vokasi
POSTGRES_PORT=5433

# Konfigurasi Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://simak_user:simak_password@db:5432/simak_vokasi
# GANTI DENGAN STRING ACAK PANJANG MINIMAL 32 KARAKTER!
JWT_SECRET=ganti_dengan_string_acak_panjang_min_32_karakter
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# Konfigurasi Frontend
FRONTEND_PORT=8080

# Mode Aplikasi (development / production)
NODE_ENV=development
VITE_APP_MODE=development

# Nama Domain & URL API Frontend
DOMAIN_NAME=simak.my.id
VITE_API_URL=/api

# Admin Default Credentials
ADMIN_EMAIL=admin@simak.id
ADMIN_PASSWORD=password123

#Resend
RESEND_API_KEY=gotoresend.com

# Google Workspace SSO (OAuth 2.0)
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=politekniksorowako.ac.id

# ===== Staging DB Sync (Production -> Staging) =====
# HANYA boleh aktif di environment STAGING. Jangan set true di production.
SYNC_STAGING_ENABLED=false
LOCAL_SYNC=true
PROD_DB_NAME=simak_vokasi
PROD_DB_USER=simak_user
PROD_DB_CONTAINER=simak_db
STAGING_DB_CONTAINER=simak_db_staging
STAGING_BACKEND_CONTAINER=simak_backend_staging
STAGING_BACKEND_URL=http://localhost:3001
SYNC_TELEGRAM_ENABLED=false
# Fallback SSH (hanya bila LOCAL_SYNC=false)
PROD_SSH_HOST=localhost
PROD_SSH_USER=deploy
PROD_SSH_PORT=22
PROD_SSH_KEY=~/.ssh/id_rsa_staging_pull