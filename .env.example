# Konfigurasi Database PostgreSQL
POSTGRES_USER=simak_user
POSTGRES_PASSWORD=simak_password
POSTGRES_DB=simak_vokasi
POSTGRES_PORT=5433

# Konfigurasi Backend
BACKEND_PORT=3000
DATABASE_URL=postgresql://simak_user:simak_password@db:5432/simak_vokasi
# GANTI DENGAN STRING ACAK PANJANG MINIMAL 32 KARAKTER!
JWT_SECRET=ganti_dengan_string_acak_panjang_min_32_karakter
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# Konfigurasi Frontend
FRONTEND_PORT=8080

# Mode Aplikasi (development / production)
NODE_ENV=development
VITE_APP_MODE=development

# Nama Domain & URL API Frontend
DOMAIN_NAME=simak.my.id
VITE_API_URL=/api

# Admin Default Credentials
ADMIN_EMAIL=admin@simak.id
ADMIN_PASSWORD=password123

#Resend
RESEND_API_KEY=gotoresend.com