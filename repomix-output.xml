              value={statusFilter()}
              onChange={(e) => setStatusFilter(e.currentTarget.value)}
            >
              <option value="">Semua</option>
              <option value="belum_bayar">Belum Bayar</option>
              <option value="cicilan">Cicilan</option>
              <option value="lunas">Lunas</option>
            </select>
          </div>
        </div>

        {/* Table */}
