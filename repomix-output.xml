    const params = new URLSearchParams({ mahasiswaId: String(mahasiswaId) });
    if (periodeId) params.append('periodeId', periodeId);
    return fetchApi<Record<string, unknown>>(`/presensi/rekap-kehadiran-mahasiswa?${params.toString()}`);
