        <Show when={sessions.loading}>
          <div class="text-center py-8 text-secondary-400">Memuat...</div>
        </Show>

        <Show when={sessions.loading}>
          <div class="text-center py-8 text-secondary-400">Memuat...</div>
        </Show>

        <Show when={sessions()}>
          {(() => {
            const today = new Date();
            type SessionItem = {
              id: number;
              nama: string;
              tanggalMulai: string;
              tanggalTutup: string;
              kuota?: number;
              isActive: boolean;
