@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    @apply bg-brand-50/40 text-secondary-800 transition-colors duration-200;
  }

  html.dark body {
    @apply bg-secondary-950 text-secondary-100;
  }

  ::selection {
    @apply bg-accent-400/30 text-brand-900;
  }

  html.dark ::selection {
    @apply bg-accent-400/20 text-accent-100;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }

  ::-webkit-scrollbar-track {
    @apply bg-transparent;
  }

  ::-webkit-scrollbar-thumb {
    @apply bg-secondary-300 rounded-full;
  }

  ::-webkit-scrollbar-thumb:hover {
    @apply bg-secondary-400;
  }

  html.dark ::-webkit-scrollbar-thumb {
    @apply bg-secondary-700;
  }

  html.dark ::-webkit-scrollbar-thumb:hover {
    @apply bg-secondary-600;
  }
}

@layer components {
  /* Card base pattern */
  .card {
    @apply bg-white border border-secondary-100 rounded-2xl shadow-card transition-all duration-200;
  }

  .card-hover {
    @apply card hover:shadow-card-hover hover:border-secondary-200 hover:-translate-y-0.5;
  }

  html.dark .card {
    @apply bg-secondary-900 border-secondary-800 shadow-card-dark;
  }

  html.dark .card-hover {
    @apply hover:border-secondary-700;
  }

  /* Page wrapper */
  .page-container {
    @apply max-w-7xl mx-auto space-y-6;
  }

  /* Section heading */
  .section-heading {
    @apply text-lg font-heading font-semibold text-brand-900 dark:text-white;
  }

  /* Subtle gradient background for content area */
  .content-gradient {
    @apply bg-gradient-to-br from-brand-50/30 via-transparent to-accent-50/20;
  }

  html.dark .content-gradient {
    @apply from-secondary-950 via-transparent to-secondary-950;
  }
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
}

@media print {
  html, body, #root, #root > div, main, .min-h-screen, .flex, .flex-col {
    display: block !important;
    position: static !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: visible !important;
    background: white !important;
    color: black !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  div.fixed.inset-0.z-50 {
    position: static !important;
    display: block !important;
    width: 100% !important;
    height: auto !important;
    background: white !important;
    backdrop-filter: none !important;
    padding: 0 !important;
    margin: 0 !important;
    z-index: auto !important;
  }

  div.fixed.inset-0.z-50 > div {
    box-shadow: none !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    background: white !important;
    display: block !important;
  }

  aside,
  header,
  nav,
  aside.flex,
  header.flex,
  nav.flex,
  .print\:hidden,
  div.print\:hidden,
  .flex-col.gap-6 > div:not(.fixed),
  table:not(#print-area-invoice table):not(#print-area-receipt table):not(#print-area-khs table):not(#print-area-transkrip table):not(#print-area-ujian table):not(#print-area-bkd table),
  .flex.justify-between.items-center.mt-4,
