              onInput={(e) => setKeterangan(e.currentTarget.value)}
              required
            />
          </div>
          <div class="flex justify-end gap-2 mt-4">
            <Button onClick={() => setShowPayModal(false)} variant="secondary">
              Batal
            </Button>
            <Button type="submit" variant="primary">
              Simpan Pelunasan
            </Button>
          </div>
        </form>
      </Modal>
    </MainLayout>
  );
}
