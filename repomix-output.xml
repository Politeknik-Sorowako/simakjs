    console.log(`- Periode Akademik ${periodId} sudah ada.`);
  }

  // 2. Seed Users untuk masing-masing role
  const roles = ['admin', 'dosen', 'mahasiswa', 'prodi', 'keuangan', 'guest'] as const;
