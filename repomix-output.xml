                <button onClick={() => setShowPrintInvoice(false)} class="text-secondary-400 hover:text-secondary-600">
                  ❌
                </button>
              </div>
              <div class="flex flex-col gap-4 text-secondary-900 dark:text-white" id="print-area-invoice">
