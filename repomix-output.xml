    it('harus gagal menambahkan dosen jika NIP duplikat (Constraint)', async () => {
      const adminToken = await getAuthToken('admin-dosen@test.com', 'admin');
      const payload = {
        nip: '199001012020011001',
        nama: 'Dosen Uji Coba',
        email: 'dosenuji@test.com',
