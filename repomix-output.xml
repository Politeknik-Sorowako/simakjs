                        <Button variant="primary" onClick={() => handleBayar(item)} class="!py-1 !px-3 text-xs">
                          Input Bayar
                        </Button>
                      </Show>
                    </Show>

                    <Show when={role() !== 'mahasiswa'}>
                      <button
                        onClick={() => handleEdit(item)}
